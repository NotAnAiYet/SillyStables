---
import Window from './shared/Window.astro';
---
<Window title="Guestbook" windowId="guestbook" icon="bi-globe" noPadding>
    <div class="guestbook-container">
        <iframe src="https://sillystables.atabook.org/" width="100%" height="100%" />
    </div>
</Window>


<style>
    .guestbook-container {
        position: relative;
        height: 100%;
        min-height: 25em;
        overflow: hidden;
    }
    .guestbook-container iframe {
        position: absolute;
        top: -4.5em;
        left: 0;
        width: 100%;
        height: calc(100% + 4em);
        border: 0;
    }
</style>
