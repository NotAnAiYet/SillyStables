---
import Window from '../shared/Window.astro';
import Title from './Title.astro';
import blackStar from '../../assets/media/pixels/blackStar.gif';
import blackSkull from '../../assets/media/pixels/blackSkull.gif';
import blackHeart from '../../assets/media/pixels/blackHeart.gif'
import wave from '../../assets/media/pixels/wave.gif'
import catBlush from '../../assets/media/pixels/catBlush.gif'
import parappa from '../../assets/media/pixels/parappa.gif'

const intro = "I'm a collector of weird ideas and lover of horses.";
const listItems = [
        {bullet: blackSkull.src, text: 'Currently learning: how to ride without looking like an idiot'},
        {bullet: blackStar.src, text: 'Recent Obsession: Horse Magnifier: The Full Horse'},
        {bullet: blackHeart.src, text: 'Spirit animal: the loading spinner that never ends'}
    ];
---
<Window title="Silly Stables - About Me" icon="bi-globe" windowId="about">
    <div class="retro-bg" aria-hidden="true"></div>
    <div class="d-flex justify-content-center pt-1 pb-2">
        <Title />
    </div>
    <div class="aboutContainer">
        <p> Welcome! <img src={wave.src}/> {intro} <img src={catBlush.src}/> </p>
        <p>This page is my little playground where I explore the intersection of nostalgia and modern web development. <br /> I build things on the web, study for my bachelor, go riding and believe in silly ideas making the world a bit brighter. <img src={parappa.src} /></p>      
        <ul>
            {listItems.map((item) => (
            <li><img src={item.bullet}/>  {item.text}</li>
            ))}
        </ul>
    </div>
</Window>

 <style>
    div[data-window="about"], .window-content, h1 {
    } 

    div[data-window="about"], .window-content, ul, li {
          list-style-type: none; 
    } 

    .aboutContainer {
        background:rgba(255, 248, 220, 0.78);
        border: 4px double #c41e3a;
        box-shadow: 4px 4px 0 #1a1a2e;
        padding: 1.25rem 1.5rem;
        backdrop-filter: blur(4px);
    }

    .retro-bg {
        position: absolute;
        inset: 0;
        z-index: -2;
        background-color: #2b1055;
        background-image: url("https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?auto=format&fit=crop&w=1920&q=80");
        background-size: cover;
        background-position: center;
    }

    .retro-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            135deg,
            rgba(255, 0, 150, 0.15) 0%,
            rgba(0, 200, 255, 0.12) 50%,
            rgba(255, 200, 0, 0.1) 100%
        );
        pointer-events: none;
    }
</style>