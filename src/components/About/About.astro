---
import Window from '../shared/Window.astro';
import CopyCode from '../shared/CopyCode.astro';
import Title from './Title.astro';
import blackStar from '../../assets/media/pixels/blackStar.gif';
import blackSkull from '../../assets/media/pixels/blackSkull.gif';
import blackHeart from '../../assets/media/pixels/blackHeart.gif'
import wave from '../../assets/media/pixels/wave.gif'
import catBlush from '../../assets/media/pixels/catBlush.gif'
import parappa from '../../assets/media/pixels/parappa.gif'
import horsey from '../../assets/media/pixels/horsey.gif'

const listItems = [
        {bullet: blackSkull.src, html: 'Currently learning: how to ride without looking like an idiot'},
        {bullet: blackStar.src, html: 'Recent Obsession: Horse Magnifier: The Full Horse'},
        {bullet: blackHeart.src, html: `Spirit animal: a <strong>horse</strong> ... duh <img src="${horsey.src}" />`},
    ];

const buttonSrc = '/media/Button.gif';
const buttonUrl = Astro.site ? new URL(buttonSrc, Astro.site).href : buttonSrc;
---
<Window title="Silly Stables - About" icon="bi-globe" windowId="about" noPadding>
    <div class="about">
        <div class="retro-bg" aria-hidden="true"></div>
        <div class="d-inline-flex flex-column align-items-center about-body">
            <div class="d-flex justify-content-center pt-1 pb-2 px-2">
                <Title />
            </div>
            <div class="aboutContainer">
                <p> Welcome to my Silly Stables! <img src={wave.src}/> </p>
                <p>This page is my little playground where I explore the intersection of nostalgia and modern web development. <br /> I build things on the web, study for my bachelor, go riding and believe in silly ideas making the world a bit brighter. <img src={parappa.src} /></p>      
                <ul>
                    {listItems.map((item) => (
                    <li><img src={item.bullet}/>  <Fragment set:html={item.html} /></li>
                    ))}
                </ul>
                <h2>Link me!</h2>
                <img src={buttonSrc} alt="Silly Stables" width="88" height="31" />
                <CopyCode maxSize={30} code={`<a href="https://silly.boats"><img src="${buttonUrl}" alt="Silly Stables"></a>`} />
            </div>
        </div>
    </div>
</Window>

 <style>
    .about {
        position: relative;
        isolation: isolate;
    }

    :global(.wb-body) .about {
        min-height: 100%;
    }

    .about-body {
        width: 100%;
        height: 100%;
        gap: 1em;
        position: relative;
        z-index: 1;
    }

    .about-body ul, .about-body li {
        list-style-type: none;
    }

    .aboutContainer {
        background:#cecbb7;
        border: 4px double #c41e3a;
        box-shadow: 4px 4px 0 #1a1a2e;
        padding: 1.25rem 1.5rem;
        backdrop-filter: blur(4px);
    }

    .retro-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-color: #2b1055;
        background-image: url("https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?auto=format&fit=crop&w=1920&q=80");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .retro-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(255, 0, 150, 0.15) 0%,
            rgba(0, 200, 255, 0.12) 50%,
            rgba(255, 200, 0, 0.1) 100%
        );
        pointer-events: none;
    }

    h2 {
        font-family: "Press Start 2P", cursive;
        font-size: 80%;
        line-height: 1.7;
        color: #941910;
        border-bottom: 2px groove #e78616;
    }
</style>