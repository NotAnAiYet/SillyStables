---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutMe from '../components/AboutMe.astro';
import LastUpdated from '../components/LastUpdated.astro';
import DesktopIcons from '../components/DesktopIcons.astro';
---
<BaseLayout title="Silly Stables - Under Construction">
  <DesktopIcons />
   <div class="main-content row pt-2 g-4">
    <div class="col-lg-8 d-flex flex-column gap-4">
      <AboutMe />
    </div>
    <aside class="d-flex  flex-row-reverse col-lg-4">
      <LastUpdated />
    </aside>
  </div>
</BaseLayout>

<style>
    @media (min-width: 992px) {
        .main-content {
          margin-top: 1rem;
        }

    }
</style>

<script>
  import { WindowManager } from '../lib/WindowManager.ts';
  new WindowManager();
</script>