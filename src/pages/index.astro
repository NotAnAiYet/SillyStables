---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About/About.astro';
import LastUpdated from '../components/LastUpdated.astro';
import Webring from '../components/Webring.astro';
import Guestbook from '../components/Guestbook.astro';
import Favorites from '../components/Favorites.astro';
import DesktopIcons from '../components/DesktopIcons/DesktopIcons.astro';
import 'winbox/dist/css/winbox.min.css';
---
<BaseLayout title="Silly Stables">
  <DesktopIcons />
  <Webring />
   <div class="main-content row pt-2 g-4">
    <div class="col-lg-8 d-flex flex-column gap-4">
      <About />
      <Favorites />
    </div>
    <aside class="d-flex  flex-column col-lg-4 gap-4">
      <Guestbook />
      <LastUpdated />
    </aside>
  </div>

  <Fragment slot="scripts">
    <script src="https://louisabraham.github.io/nekojs/neko.js" data-autostart></script>
  </Fragment>
</BaseLayout>

<style>
    @media (min-width: 992px) {
        .main-content {
          margin-top: 1rem;
        }

    }
</style>

<script>
    import { WinBoxController } from '../lib/WinBoxController.ts';
    new WinBoxController();
</script>
